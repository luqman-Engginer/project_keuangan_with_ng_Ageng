+/* Transisi antar halaman */
+body { animation: fade-in .5s ease both; }
+body.is-leaving { opacity: 0; transform: scale(.995); transition: opacity .22s ease, transform .22s ease; }
+
+/* Toast */
+.toast-stack { position: fixed; top: 1rem; right: 1rem; z-index: 100; display: flex; flex-direction: column; gap: .6rem; width: min(24rem, calc(100vw - 2rem)); }
+.toast {
+    position: relative; overflow: hidden;
+    display: flex; gap: .75rem; align-items: flex-start;
+    padding: .9rem 1rem; border-radius: 1rem;
+    background: var(--surface-solid); color: var(--text);
+    border: 1px solid var(--border);
+    box-shadow: 0 20px 40px -16px rgba(0, 0, 0, .35);
+    animation: toast-in .55s cubic-bezier(.34, 1.56, .64, 1) both;
+}
+.toast.out { animation: toast-out .35s ease forwards; }
+.toast .bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; transform-origin: left; animation: bar 4.5s linear forwards; }
+.toast-success .bar { background: linear-gradient(90deg, #10b981, #14b8a6); }
+.toast-error   .bar { background: linear-gradient(90deg, #f43f5e, #ec4899); }
+@keyframes toast-in  { from { opacity: 0; transform: translateX(120%) scale(.9); } to { opacity: 1; transform: none; } }
+@keyframes toast-out { to { opacity: 0; transform: translateX(120%) scale(.9); } }
+@keyframes bar { to { transform: scaleX(0); } }
+
+/* Modal konfirmasi */
+.modal-backdrop {
+    position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 1rem;
+    background: rgba(7, 11, 25, .55); backdrop-filter: blur(8px);
+    animation: fade-in .25s ease both;
+}
+.modal-box {
+    width: 100%; max-width: 24rem; padding: 1.75rem; border-radius: 1.75rem; text-align: center;
+    background: var(--surface-solid); color: var(--text); border: 1px solid var(--border);
+    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, .5);
+    animation: pop .45s cubic-bezier(.34, 1.56, .64, 1) both;
 }
 
-::-webkit-scrollbar-thumb:hover {
-    background-color: #94a3b8;
+/* Skeleton / tombol loading */
+.is-loading { pointer-events: none; opacity: .8; }
+.is-loading::before {
+    content: ''; width: 1rem; height: 1rem; border-radius: 9999px;
+    border: 2px solid rgba(255,255,255,.4); border-top-color: #fff;
+    animation: spin .7s linear infinite;
+}
+@keyframes spin { to { transform: rotate(360deg); } }
+
+/* Scrollbar */
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-thumb { background: linear-gradient(#a5b4fc, #c4b5fd); border-radius: 10px; }
+
+nav[aria-label="Pagination Navigation"] { display: flex; justify-content: center; }
+
+/* ============================================================
+   DARK MODE: override utility bawaan yang dipakai di banyak view
+   ============================================================ */
+.dark .bg-white { background-color: var(--surface-solid); }
+.dark .bg-slate-50, .dark .bg-slate-50\/60 { background-color: rgba(255, 255, 255, .04); }
+.dark .bg-slate-100 { background-color: rgba(255, 255, 255, .08); }
+.dark .text-slate-800, .dark .text-slate-700 { color: var(--text); }
+.dark .text-slate-600, .dark .text-slate-500 { color: var(--muted); }
+.dark .border-slate-100, .dark .border-slate-200, .dark .border-slate-50 { border-color: var(--border); }
+.dark .bg-indigo-50, .dark .bg-indigo-100 { background-color: rgba(99, 102, 241, .16); }
